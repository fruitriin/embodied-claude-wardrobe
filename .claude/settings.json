{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-boot.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "/bin/bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/reset-turn-count.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-compact-recovery.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/interoception.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "/bin/bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/recall-hook.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "/bin/bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hearing-hook.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "/bin/bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/turn-reminder.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "/bin/bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-keyword-buffer.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/skill-usage-log.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hearing-stop-hook.sh",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "autoMemoryEnabled": false,
  "permissions": {
    "allow": [
      "mcp__memory__*",
      "mcp__hearing__*",
      "mcp__wifi-cam__*",
      "Bash(bun run:*)",
      "Bash(bun:*)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Skill(wd-read)",
      "Skill(wd-great-recall)",
      "Agent",
      "Skill",
      "LSP",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskOutput",
      "TaskStop",
      "TaskUpdate",
      "TeamCreate",
      "TeamDelete",
      "SendMessage",
      "ToolSearch",
      "Bash(* --help)",
      "Bash(* --help *)",
      "Bash(* --version)",
      "Bash(cp *)",
      "Bash(mkdir *)",
      "Bash(ls *)",
      "Bash(tail *)",
      "Bash(cd *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git rm *)",
      "Bash(git ls-files *)",
      "Bash(git branch *)",
      "Bash(git worktree *)",
      "Bash(git checkout *)",
      "Bash(git show *)",
      "Bash(git merge *)",
      "Bash(git stash *)",
      "Bash(git clone *)",
      "Bash(git -C *)",
      "Bash(mktemp *)",
      "Bash(which *)",
      "Bash(gh repo view *)",
      "Bash(gh repo list *)",
      "Bash(gh repo clone *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue status *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue create *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr status *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr checkout *)",
      "Bash(gh pr create *)",
      "Bash(gh api *)",
      "Bash(bash .claude/addf/tests/run-all.sh *)",
      "Bash(uv run --python 3.11 .claude/addf/addfTools/lint *)",
      "Bash(uv run --python 3.11 .claude/addf/addfTools/speculate-guard.py *)",
      "Bash(uv run --python 3.11 .claude/addf/addfTools/speculate-integrate.py *)",
      "Bash(uv run --python 3.11 .claude/addf/addfTools/speculate-reconcile.py *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)"
    ]
  }
}
